# where the panel exposes this container; both must be set
NODE_HOST=se2.nodaroo.fun
SERVER_PORT=2467

# what to run: vless / hy2 / ss  (ss moves to SS_PORT when hy2 is on)
# one port only, so no ss: mihomo cannot bind the same TCP port twice
ENABLE=vless,hy2
NODE_NAME=my-node

# reality: a real TLS 1.3 site that terminates TCP 443, not behind Cloudflare
REALITY_SNI=www.microsoft.com
REALITY_HANDSHAKE=
REALITY_SHORT_ID=

# reality keypair: leave empty, one is generated on first start and kept in
# state.json. Paste a pair (from `mihomo generate reality-keypair`) only to pin it.
REALITY_PRIVATE_KEY=
REALITY_PUBLIC_KEY=

# hysteria2: empty HY2_SNI = use NODE_HOST
HY2_SNI=
HY2_OBFS=
HY2_OBFS_PASSWORD=
HY2_UP_MBPS=
HY2_DOWN_MBPS=

# shadowsocks 2022
SS_METHOD=2022-blake3-aes-128-gcm
SS_PORT=

# core: mihomo (default) or singbox
CORE=mihomo
MIHOMO_VERSION=1.19.34

# behaviour
WATCHDOG=1
LOG_LEVEL=warn
MIRROR=
