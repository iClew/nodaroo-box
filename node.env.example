# where the panel exposes this container
NODE_HOST=au2.example.com
SERVER_PORT=2522

# what to run: vless / hy2 / ss  (ss moves to SS_PORT when hy2 is on)
ENABLE=vless,hy2,ss
NODE_NAME=my-node

# reality: a real TLS 1.3 site that terminates TCP 443, not behind Cloudflare
REALITY_SNI=www.microsoft.com
REALITY_HANDSHAKE=
REALITY_SHORT_ID=

# mihomo cannot generate a Reality keypair; paste one from
#   sing-box generate reality-keypair
REALITY_PRIVATE_KEY=
REALITY_PUBLIC_KEY=

# hysteria2: empty HY2_SNI = use NODE_HOST
HY2_SNI=
HY2_OBFS=
HY2_OBFS_PASSWORD=
HY2_UP_MBPS=
HY2_DOWN_MBPS=

# shadowsocks 2022
SS_METHOD=2022-blake3-aes-128-gcm
SS_PORT=

# core: mihomo (default) or singbox
CORE=mihomo
MIHOMO_VERSION=1.19.34

# behaviour
WATCHDOG=1
LOG_LEVEL=warn
MIRROR=
