# nodaroo-box settings. Copy this file if you already have node.env.
# Environment variables set in the panel override these values.

# public hostname the panel gives you (NOT the container IP)
NODE_HOST=se2.nodaroo.fun

# port the panel allocated; usually has to be set explicitly
SERVER_PORT=2467

# entry points: vless / hy2 / ss
# one port only, so no ss: mihomo cannot bind the same TCP port twice
ENABLE=vless,hy2
NODE_NAME=my-node

# reality: a TLS 1.3 site that answers on TCP 443, not behind Cloudflare
REALITY_SNI=www.microsoft.com
REALITY_HANDSHAKE=
REALITY_SHORT_ID=

# reality keypair. Works as shipped; make a new one with
#   sing-box generate reality-keypair
REALITY_PRIVATE_KEY=sOba_26eOniNepghpLOZRovz_FXuahSE3SkbD-_6WGA
REALITY_PUBLIC_KEY=mwzqU8kxMA8o9ubeobVFCR0eAlKI4uEzvYm9odYphyk

# hysteria2 (empty HY2_SNI = use NODE_HOST)
HY2_SNI=
HY2_OBFS=
HY2_OBFS_PASSWORD=
HY2_UP_MBPS=
HY2_DOWN_MBPS=

# shadowsocks 2022
SS_METHOD=2022-blake3-aes-128-gcm
SS_PORT=

# core: mihomo (default) or singbox
CORE=mihomo

# behaviour
WATCHDOG=1
LOG_LEVEL=warn
MIRROR=
